# Получите токен в настройках созданного бота MAX.
MAX_BOT_TOKEN=

# polling — для локальной разработки, webhook — для production.
BOT_MODE=polling
PORT=3000

# Нужны только для BOT_MODE=webhook.
PUBLIC_BASE_URL=https://bot.example.com
WEBHOOK_SECRET=replace-with-a-long-random-string
# Если не задан, SDK сформирует путь из хеша токена.
WEBHOOK_PATH=

# В Docker этот путь сохраняется в именованном volume.
STATE_FILE=./data/state.json
REMINDER_POLL_INTERVAL_MS=30000
DEFAULT_TIMEZONE_OFFSET_MINUTES=180
