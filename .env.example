# Токен созданного бота MAX. Не добавляйте реальное значение в Git.
MAX_BOT_TOKEN=

# polling для локального запуска, webhook для сервера с внешним HTTPS-адресом.
BOT_MODE=polling
PORT=3000

# Параметры webhook-режима.
PUBLIC_BASE_URL=https://bot.example.com
WEBHOOK_SECRET=replace-with-a-long-random-string
# Если путь не задан, приложение сформирует его из хеша токена.
WEBHOOK_PATH=

# Хранилище и параметры фоновой проверки напоминаний.
STATE_FILE=./data/state.json
REMINDER_POLL_INTERVAL_MS=30000
DEFAULT_TIMEZONE_OFFSET_MINUTES=180
